# Bản mẫu của .env — copy thành `.env` (cùng thư mục, gốc repo) rồi điền giá
# trị thật. File .env thật KHÔNG được commit (.gitignore đã che); file mẫu này
# thì commit để nhớ cấu trúc.

# Page Facebook MimiAudio — Page access token dài hạn để đăng bài
# (quyền pages_manage_posts)
FB_PAGE_ID_MIMIAUDIO=123456789012345
FB_PAGE_ACCESS_TOKEN_MIMIAUDIO=EAAxxxxxxxxxxxxxxxxx
